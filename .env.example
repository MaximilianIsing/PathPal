# Copy this file to .env and fill in your values. Do not commit .env.

# Optional: on Render, set to your persistent disk mount path (e.g. /data or /storage) so data survives redeploys
# STORAGE_PATH=/data

# Optional: secret for POST /api/apple/grant-pro (grant a user Pro without waiting for Apple webhook)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SUBSCRIPTION_GRANT_SECRET=
